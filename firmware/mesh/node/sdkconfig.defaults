# tools/tests/stack_budget.py checks the deepest known chains against this.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24000
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="/mesh/node/partitions.csv"
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Bluetooth Classic and BLE together. ESPHome cannot build this.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
CONFIG_BT_ACL_CONNECTIONS=3
CONFIG_BT_BTC_TASK_STACK_SIZE=4096

# One radio shared by ESP-NOW, BLE, and Classic. Keep Wi-Fi modem sleep on:
# ESP-IDF needs it while Bluetooth runs.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# Wi-Fi, BLE, and Classic together overflow instruction RAM by 2.6 KB. This frees
# about 17 KB. It only speeds Wi-Fi receive at throughputs this mesh never needs.
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# Matches the ESPHome nodes, and makes a 2 ms delay a real delay.
CONFIG_FREERTOS_HZ=1000

# A new image stays pending until this node marks it valid. A crash before that
# boots the previous slot. The bootloader this build produces has to be the one
# that is flashed, because the check lives there.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The rollback timer runs the reboot and its shutdown handlers on this task.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=6144
