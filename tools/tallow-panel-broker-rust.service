[Unit]
Description=H7020 agent socket broker
Documentation=file:///home/btgrant/Projects/tallow/docs/devices/govee-h7020.md
# Both listen on one vsock port. Starting this one stops the Python broker.
Conflicts=tallow-panel-broker.service

[Service]
# The live copy, not host/target/release. daemon build rewrites the release binary.
ExecStart=%h/Projects/tallow/host/target/live/tallow-broker
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
